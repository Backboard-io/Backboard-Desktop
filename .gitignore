# macOS system files
.DS_Store

# Python bytecode
__pycache__/
*.py[cod]

# Node.js dependencies (ignore at any depth)
node_modules/
**/node_modules/
.npm-cache/
**/.npm-cache/

# Local VS Code packaging outputs. Globbed per architecture: only arm64 was
# listed, so an Intel build dropped a couple of GB of untracked output at the
# repo root.
/VSCode-darwin-*/
/vscode-release/
/vscode-release-*/
/VSCode-win32-*/
/windows-release/
/vscode/extensions/backboard/bin/
/backboard/extensions/backboard/bin/
/vscode/cli-ts/.*.bun-build
/backboard/cli-ts/.*.bun-build

# The source tree is being renamed from vscode/ to backboard/. Keep local
# build state ignored from either path while the rename is in progress.
/vscode/.build/
/backboard/.build/

# Per-workspace Backboard metadata is local machine state.
/.backboard/

# Generated smoke-test and benchmark runs. Keep the curated assets already
# tracked under artifacts/, but exclude these high-volume, reproducible outputs.
/artifacts/codex-subscription-e2e/
/artifacts/terminal-bench-4.0/arm64-musl-runtime-test/
/artifacts/terminal-bench-4.0/final-report/
/artifacts/terminal-bench-4.0/jobs/
/artifacts/terminal-bench-4.0/regrades/

# The DMG installer-window assets under scripts/dmg-assets/ are deliberately
# NOT ignored. A previous revision ignored that whole directory, generators
# included, so the toolchain was lost -- and because packaging only warns when
# the assets are missing, releases silently shipped a bare Finder window.

# Local debug/automation scratch output (launch scripts, Playwright driving,
# UI screenshots). Regenerated per run; never part of a build.
/vscode/launch_info*.json
/vscode/launch_stderr*.log
/vscode/pw_session.env
/vscode/screenshots/
/vscode/Lefpanelold.md
/backboard/launch_info*.json
/backboard/launch_stderr*.log
/backboard/pw_session.env
/backboard/screenshots/
/backboard/Lefpanelold.md
# @playwright/cli drops a session-artifacts dir (snapshots, console logs)
# in whatever cwd it runs from — unanchored so it is caught anywhere.
.playwright-cli/

# Local-only Zed scratch files
zed/crates/beginner_ui/src/beginner_workspace.rs
zed/crates/beginner_ui/src/simple_design.rs
