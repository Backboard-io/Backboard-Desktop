# Analytics + ad conversion tracking. Everything is OFF until its id is set.
# Full map of events -> platforms: lib/analytics/README.md

# ── PostHog (product analytics, funnels, session replay) ──────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Meta (Facebook / Instagram) pixel ────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
# Server side (Conversions API), for purchases confirmed by the backend:
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v23.0

# ── Google Ads ───────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ADS_ID=            # AW-XXXXXXXXX
# One label per conversion action (the part after the slash in send_to):
NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_SIGNUP=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_ACTIVATION=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CHECKOUT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_TRIAL=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_SUBSCRIBE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PURCHASE=

# ── X (Twitter) pixel ────────────────────────────────────────────────
NEXT_PUBLIC_X_PIXEL_ID=
# One event id (tw-xxxxx-yyyyy) per conversion from X Events Manager:
NEXT_PUBLIC_X_EVENT_LEAD=
NEXT_PUBLIC_X_EVENT_SIGNUP=
NEXT_PUBLIC_X_EVENT_ACTIVATION=
NEXT_PUBLIC_X_EVENT_CHECKOUT=
NEXT_PUBLIC_X_EVENT_TRIAL=
NEXT_PUBLIC_X_EVENT_SUBSCRIBE=
NEXT_PUBLIC_X_EVENT_PURCHASE=

# ── LinkedIn Insight Tag ─────────────────────────────────────────────
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# One numeric conversion id per conversion from Campaign Manager:
NEXT_PUBLIC_LINKEDIN_CONVERSION_LEAD=
NEXT_PUBLIC_LINKEDIN_CONVERSION_SIGNUP=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ACTIVATION=
NEXT_PUBLIC_LINKEDIN_CONVERSION_CHECKOUT=
NEXT_PUBLIC_LINKEDIN_CONVERSION_TRIAL=
NEXT_PUBLIC_LINKEDIN_CONVERSION_SUBSCRIBE=
NEXT_PUBLIC_LINKEDIN_CONVERSION_PURCHASE=
# Server side (Conversions API):
LINKEDIN_CAPI_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202509

# ── Server-side conversions endpoint (/api/conversions) ──────────────
# app.backboard.io's backend sends "Authorization: Bearer <this>".
CONVERSIONS_WEBHOOK_SECRET=

# ── Behaviour ────────────────────────────────────────────────────────
# "required" = load nothing until setAnalyticsConsent(true) (cookie banner).
NEXT_PUBLIC_ANALYTICS_CONSENT=granted
NEXT_PUBLIC_ANALYTICS_COOKIE_DOMAIN=.backboard.io
NEXT_PUBLIC_ANALYTICS_DEBUG=0
