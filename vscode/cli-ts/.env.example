# Required for normal use.
BACKBOARD_API_KEY=your_key_here

# Optional.
# BACKBOARD_API_URL=https://app.backboard.io/api

# Required for q login.
# This is the OAuth client id from the Backboard dashboard.
# BACKBOARD_OAUTH_CLIENT_ID=your_oauth_client_id_here

# Do not put an OAuth client secret in q-cli.
# CLI OAuth should use PKCE, so the secret must stay out of source code,
# frontend pages, and local CLI env files.
