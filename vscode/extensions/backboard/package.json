{
  "name": "backboard",
  "displayName": "Backboard",
  "description": "Backboard agent bridge for VS Code",
  "version": "0.1.0",
  "publisher": "backboard",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "main": "./out/extension",
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:backboard.panel",
    "onCommand:backboard.setApiKey",
    "onCommand:backboard.openPanel",
    "onCommand:backboard.openRightPanel"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "backboard.openPanel",
        "title": "Open Panel",
        "category": "Backboard"
      },
      {
        "command": "backboard.openRightPanel",
        "title": "Open Right Panel",
        "category": "Backboard"
      },
      {
        "command": "backboard.setApiKey",
        "title": "Set API Key",
        "category": "Backboard"
      },
      {
        "command": "backboard.refreshModels",
        "title": "Refresh Models",
        "category": "Backboard"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "backboard",
          "title": "Backboard",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "backboard": [
        {
          "id": "backboard.panel",
          "type": "webview",
          "name": "Backboard"
        }
      ]
    },
    "configuration": [
      {
        "title": "Backboard",
        "properties": {
          "backboard.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "Backboard API key. If empty, the bridge uses `~/.backboard/config.json` or `BACKBOARD_API_KEY`.",
            "scope": "machine-overridable"
          },
          "backboard.env": {
            "type": "string",
            "enum": [
              "prod",
              "dev",
              "local"
            ],
            "default": "prod",
            "description": "Backboard API environment."
          },
          "backboard.apiUrl": {
            "type": "string",
            "default": "",
            "description": "Custom Backboard API base URL. Overrides the environment when set."
          },
          "backboard.defaultProvider": {
            "type": "string",
            "default": "aws-bedrock",
            "description": "Default Backboard model provider."
          },
          "backboard.defaultModel": {
            "type": "string",
            "default": "anthropic.claude-sonnet-4-6",
            "description": "Default Backboard model name."
          },
          "backboard.mode": {
            "type": "string",
            "enum": [
              "agent",
              "ask",
              "manual",
              "free"
            ],
            "default": "agent",
            "description": "Backboard tool mode."
          },
          "backboard.intensity": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "default": "fast",
            "description": "Reasoning intensity sent to Backboard."
          },
          "backboard.webSearch": {
            "type": "string",
            "enum": [
              "off",
              "Auto"
            ],
            "default": "off",
            "description": "Web search setting for Backboard turns."
          },
          "backboard.imageGeneration": {
            "type": "string",
            "enum": [
              "off",
              "auto"
            ],
            "default": "off",
            "description": "Image generation setting for Backboard turns."
          },
          "backboard.mcpFigma": {
            "type": "boolean",
            "default": false,
            "description": "Send Figma MCP calls as enabled for Backboard turns."
          },
          "backboard.mcpNotion": {
            "type": "boolean",
            "default": false,
            "description": "Send Notion MCP calls as enabled for Backboard turns."
          },
          "backboard.mcpGoogle": {
            "type": "boolean",
            "default": false,
            "description": "Send Google MCP calls as enabled for Backboard turns."
          },
          "backboard.voiceMode": {
            "type": "string",
            "enum": [
              "off",
              "tts",
              "stt",
              "conversation"
            ],
            "default": "off",
            "description": "Backboard voice mode for REST turns. TTS synthesizes assistant audio; STT and conversation require audio attachment support."
          },
          "backboard.bridgePath": {
            "type": "string",
            "default": "",
            "description": "Path to the local backboard-bridge binary. Leave empty for the built-in development/package lookup."
          }
        }
      }
    ]
  },
  "scripts": {
    "build-bridge": "cd ../../../zed && cargo build -p backboard_bridge",
    "compile": "gulp compile-extension:backboard",
    "watch": "gulp watch-extension:backboard",
    "typecheck": "tsgo --project ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
