				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#72644A"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#945426"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#4E6C39"
			}
		},
		{
			"name": "Functions",
			"scope": [
