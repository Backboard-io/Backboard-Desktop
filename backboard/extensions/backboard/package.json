{
  "name": "backboard",
  "displayName": "Backboard",
  "description": "Backboard agent bridge for Backboard Studio",
  "version": "0.1.0",
  "publisher": "backboard",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "main": "./out/extension",
  "enabledApiProposals": [
    "contribSourceControlInputBoxMenu"
  ],
  "categories": [
    "AI"
  ],
  "files": [
    "out/**",
    "media/**",
    "bin/**",
    "package.json"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:backboard.extension.signIn",
    "onCommand:backboard.extension.signOut",
    "onCommand:backboard.setApiKey",
    "onCommand:backboard.configureProviderKey",
    "onCommand:backboard.setupProviderKey",
    "onCommand:backboard.hasAlternativeCredentials",
    "onCommand:backboard.refreshModels",
    "onCommand:backboard.generateCommitMessage",
    "onCommand:backboard.openUsage",
    "onCommand:backboard.installTerminalCommand"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "backboard.cancelUpdate",
        "title": "Backboard: Stop Update"
      },
      {
        "command": "backboard.setApiKey",
        "title": "Backboard: Set API Key"
      },
      {
        "command": "backboard.extension.signIn",
        "title": "Backboard: Sign In"
      },
      {
        "command": "backboard.extension.signOut",
        "title": "Backboard: Sign Out"
      },
      {
        "command": "backboard.refreshModels",
        "title": "Backboard: Refresh Models"
      },
      {
        "command": "backboard.generateCommitMessage",
        "title": "Backboard: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "backboard.openUsage",
        "title": "Backboard: Open Usage"
      },
      {
        "command": "backboard.checkForUpdates",
        "title": "Backboard: Check for Updates"
      },
      {
        "command": "backboard.installAvailableUpdate",
        "title": "Backboard: Install Update",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "scm/inputBox": [
        {
          "command": "backboard.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "backboard.extension.signOut",
          "when": "false"
        },
        {
          "command": "backboard.cancelUpdate",
          "when": "backboard.updateCancellable"
        },
        {
          "command": "backboard.installAvailableUpdate",
          "when": "backboard.updateAvailable"
        }
      ]
    },
    "configuration": [
      {
        "title": "Backboard",
        "properties": {
          "backboard.apiKey": {
            "type": "string",
            "default": "",
            "editPresentation": "secretText",
            "markdownDescription": "Legacy Backboard API key fallback. Prefer **Backboard: Sign in with SSO**.",
            "scope": "machine-overridable"
          },
          "backboard.env": {
            "type": "string",
            "enum": [
              "prod",
              "dev",
              "local"
            ],
            "default": "prod",
            "description": "Backboard API environment."
          },
          "backboard.apiUrl": {
            "type": "string",
            "default": "",
            "description": "Custom Backboard API base URL. Overrides the environment when set."
          },
          "backboard.defaultProvider": {
            "type": "string",
            "default": "openrouter",
            "description": "Default Backboard model provider."
          },
          "backboard.defaultModel": {
            "type": "string",
            "default": "moonshotai/kimi-k3",
            "description": "Default Backboard model name."
          },
          "backboard.mode": {
            "type": "string",
            "enum": [
              "agent",
              "ask",
              "manual",
              "free"
            ],
            "default": "free",
            "description": "Backboard tool mode."
          },
          "backboard.intensity": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "default": "fast",
            "description": "Reasoning intensity sent to Backboard."
          },
          "backboard.imageGeneration": {
            "type": "string",
            "enum": [
              "off",
              "auto"
            ],
            "default": "off",
            "description": "Image generation setting for Backboard turns."
          },
          "backboard.mcpFigma": {
            "type": "boolean",
            "default": true,
            "description": "Request Backboard-hosted Figma MCP tool intent for Backboard turns."
          },
          "backboard.mcpNotion": {
            "type": "boolean",
            "default": false,
            "description": "Request Backboard-hosted Notion MCP tool intent for Backboard turns."
          },
          "backboard.mcpGoogle": {
            "type": "boolean",
            "default": false,
            "description": "Request Backboard-hosted Google MCP tool intent for Backboard turns."
          },
          "backboard.voiceMode": {
            "type": "string",
            "enum": [
              "off",
              "tts",
              "stt",
              "conversation"
            ],
            "default": "off",
            "description": "Backboard voice input mode. Recorded audio is attached through the public R-CLI; speech synthesis is not available in this runtime."
          },
          "backboard.cliPath": {
            "type": "string",
            "default": "",
            "description": "Path to a local Backboard R-CLI binary. Leave empty for the packaged public R-CLI runtime."
          },
          "backboard.workspaceRoot": {
            "type": "string",
            "default": "",
            "description": "Path to use as the Backboard panel workspace root. Supports ${workspaceFolder} and ${userHome}. Leave empty to use the open workspace folder. Can also be set with BACKBOARD_WORKSPACE_ROOT."
          },
          "backboard.updates.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Check the Backboard Studio S3 manifest for IDE updates after Backboard activates."
          },
          "backboard.updates.manifestBaseUrl": {
            "type": "string",
            "default": "https://backboard-studio-releases.s3.ca-central-1.amazonaws.com/ide-releases",
            "description": "Base URL for Backboard Studio update manifests."
          },
          "backboard.updates.channel": {
            "type": "string",
            "enum": [
              "",
              "stable",
              "sandbox"
            ],
            "default": "",
            "description": "Backboard Studio update channel. Leave empty to use sandbox for development builds and stable for packaged production builds."
          },
          "backboard.updates.manifestUrl": {
            "type": "string",
            "default": "",
            "description": "Full Backboard Studio update manifest URL override. Leave empty to derive the URL from the base URL, channel, platform, and architecture."
          },
          "backboard.updates.checkIntervalMinutes": {
            "type": "number",
            "default": 360,
            "minimum": 15,
            "description": "How often Backboard Studio checks the S3 update manifest while the IDE is open."
          }
        }
      }
    ]
  },
  "scripts": {
    "prepare-cli-ts": "sh -c 'if command -v bun >/dev/null 2>&1; then npm run package-cli-ts; else echo \"Skipping Backboard cli-ts build: bun not found.\"; fi'",
    "build-cli-ts": "cd ../../cli-ts && bun install --frozen-lockfile && bun run build",
    "resign-cli-ts": "sh -c 'if command -v codesign >/dev/null 2>&1; then codesign --force --sign - ./bin/backboard-cli-ts; fi'",
    "package-cli-ts": "npm run build-cli-ts && mkdir -p ./bin && cp ../../cli-ts/backboard ./bin/backboard-cli-ts && chmod 755 ./bin/backboard-cli-ts && npm run resign-cli-ts",
    "compile": "npm run prepare-cli-ts && tsgo --project ./tsconfig.json",
    "watch": "tsgo --project ./tsconfig.json --watch",
    "typecheck": "tsgo --project ./tsconfig.json --noEmit",
    "test-updater": "node --test ./out/test/updatesCancellation.test.js ./out/test/updatesInstaller.test.js ./out/test/migrationNotice.test.js ./out/test/liveUpdatesCore.test.js",
    "test-updater-integration": "node --test ./out/test/updatesInstaller.integration.test.js",
    "test-updater-e2e": "node --test ./out/test/updatesInstaller.e2e.test.js"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
